              },
              {
                "name": "questionnaire",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Gets a list of questions to ask the user in order to complete the \"Know Your Customer\" (KYC)\nquestionnaire.\n"
        },
        {
          "info": {
            "name": "Answer KYC questionnaire",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.safello.com/v2/account/kyc-questions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits the user's answers to the KYC questionnaire\n"
