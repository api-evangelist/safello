          "http": {
            "method": "GET",
            "url": "https://app.safello.com/v1/kyc",
            "params": [
              {
                "name": "lang",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
