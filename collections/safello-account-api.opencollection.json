            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.safello.com/v2/account/email",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send email to verify the user has access to that account"
        },
        {
          "info": {
            "name": "Verify email",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.safello.com/v2/account/email",
            "body": {
              "type": "json",
              "data": "{}"
            }
