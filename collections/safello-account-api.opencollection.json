        {
          "info": {
            "name": "Add or update bank account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.safello.com/v2/account/bank-account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A unique bank account (clearing number + bank account number) can only be added once to a user. Adding the same bank account a second time will update the existing and return the same Bank Account ID."
