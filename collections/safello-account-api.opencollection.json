{
  "opencollection": "1.0.0",
  "info": {
    "name": "Safello account API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Accept T&C",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.safello.com/v1/system/acceptTerms",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
          },
          "docs": "Accept Terms and Conditions"
        },
        {
          "info": {
            "name": "Send verification email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.safello.com/v1/email",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
          },
          "docs": "Send email to verify the user has access to that account"
        },
        {
          "info": {
            "name": "Verify email",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.safello.com/v1/email/verify",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
          },
          "docs": "Verify user's email address"
        },
