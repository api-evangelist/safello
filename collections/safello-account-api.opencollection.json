              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
          },
          "docs": "Use this endpoint to check is the user is required to complete the KYC questionaire to\ncontinue trading\n"
        },
        {
          "info": {
            "name": "KYC questions",
            "type": "http"
