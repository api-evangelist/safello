          "info": {
            "name": "Answer KYC questionaire",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.safello.com/v1/kyc",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Access-Token",
              "value": "{{Access-Token}}",
              "placement": "header"
            }
          },
